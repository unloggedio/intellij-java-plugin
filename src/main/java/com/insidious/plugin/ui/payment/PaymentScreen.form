<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.insidious.plugin.ui.payment.PaymentScreen">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="16" left="12" bottom="16" right="12"/>
    <constraints>
      <xy x="20" y="20" width="844" height="400"/>
    </constraints>
    <properties>
      <maximumSize width="400" height="200"/>
      <minimumSize width="400" height="200"/>
      <preferredSize width="400" height="200"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="56c7d" binding="textPanel" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="1" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="7ccbc" class="javax.swing.JLabel" binding="featureList">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font/>
              <text value="&lt;html&gt;&#10;&lt;body&gt;&#10;    &lt;ol&gt;&#10;        &lt;li&gt;Get priority support&lt;/li&gt;&#10;        &lt;li&gt;Enable AI assistance in your debugging journey&lt;/li&gt;&#10;        &lt;li&gt;Save unlimited number of mocks and tests without any&lt;br/&gt;hassle!&lt;/li&gt;&#10;    &lt;ol&gt;&#10;&lt;/body&gt;&#10;&#10;&lt;/html&gt;"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="eb603" binding="buttonPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="1" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="e2288" class="javax.swing.JButton" binding="payButton">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-13208592"/>
              <borderPainted value="false"/>
              <contentAreaFilled value="false"/>
              <doubleBuffered value="false"/>
              <focusable value="true"/>
              <foreground color="-1"/>
              <horizontalTextPosition value="11"/>
              <opaque value="true"/>
              <requestFocusEnabled value="true"/>
              <text value="Pay for premium"/>
              <visible value="true"/>
            </properties>
          </component>
          <component id="19ce6" class="javax.swing.JButton" binding="activateButton">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Activate Premium"/>
            </properties>
          </component>
        </children>
      </grid>
      <vspacer id="b8c21">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false">
            <minimum-size width="-1" height="8"/>
            <preferred-size width="-1" height="8"/>
            <maximum-size width="-1" height="8"/>
          </grid>
        </constraints>
      </vspacer>
    </children>
  </grid>
</form>
