<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.insidious.plugin.ui.payment.PremiumAdBanner">
  <grid id="96298" binding="mainPanel" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="502" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="f46ee" binding="banner" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="1" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="27dc6" binding="nonPremiumPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="12" left="14" bottom="2" right="14"/>
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="4f05e" class="javax.swing.JLabel" binding="getPremium">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="&lt;html&gt;&lt;b&gt;&lt;u&gt;Get Premium!&lt;/u&gt;&lt;/b&gt;&lt;/html&gt;"/>
                </properties>
              </component>
              <component id="4d54d" class="javax.swing.JLabel" binding="content">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font size="12"/>
                  <foreground color="-1747099"/>
                  <text value="&lt;html&gt;You're on the free version of Unlogged&lt;/html&gt;"/>
                </properties>
              </component>
            </children>
          </grid>
          <grid id="64b3c" binding="premiumPanel" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="12" left="14" bottom="2" right="14"/>
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="8d8ce" class="javax.swing.JLabel" binding="premiumUser">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <foreground color="-105256"/>
                  <text value="&lt;html&gt;&lt;b&gt;Premium User!&lt;/b&gt;&lt;/html&gt;"/>
                </properties>
              </component>
              <component id="466a3" class="javax.swing.JLabel" binding="premiumContent">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="5" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font size="12"/>
                  <foreground color="-4473925"/>
                  <text value="&lt;html&gt;Need help? Reach out to us at: &lt;/html&gt;"/>
                </properties>
              </component>
              <component id="134c3" class="javax.swing.JLabel" binding="discord">
                <constraints>
                  <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <font size="12"/>
                  <foreground color="-11236617"/>
                  <text value="&lt;html&gt;&lt;u&gt;Discord→&lt;/u&gt;&lt;/html&gt;"/>
                </properties>
